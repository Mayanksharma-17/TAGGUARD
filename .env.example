# TAGGUARD Configuration Template
# Copy this file to .env and fill in your values for live email alerts.
# .env is ignored by Git to keep your credentials safe.

TAGGUARD_GMAIL_SENDER="your-alert-sender@gmail.com"
TAGGUARD_GMAIL_PASS="your-16-char-app-password"
TAGGUARD_ALERT_TO="security-officer@example.com"
